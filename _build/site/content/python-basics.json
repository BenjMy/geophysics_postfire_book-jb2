e":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Python variables need no explicit type declaration — the interpreter infers the type from the value assigned.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"EUb9rSHlQW"}],"key":"WlZc3Agzlj"}],"key":"kHq7hEwZFd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Numeric types\nresistivity = 100.5   # float — Ohm·m\nnum_electrodes = 48   # int\n\n# String\nsurvey_type = \"Wenner array\"\n\n# List  \nmeasurements = [12.5, 15.3, 18.7, 21.2]  # apparent resistivity values\n\nprint(f\"Survey type       : {survey_type}\")\nprint(f\"Electrodes        : {num_electrodes}\")\nprint(f\"Resistivity (Ω·m) : {resistivity}\")\nprint(f\"Measurements      : {measurements}\")","key":"l7h9lrRIdF"},{"type":"outputs","id":"gB38B4MKldCnUL2F-Eja-","children":[],"key":"st7WtxLCMu"}],"key":"bhWrQyuvhI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Check the type of a variable\nprint(type(resistivity))\nprint(type(num_electrodes))\nprint(type(survey_type))\nprint(type(measurements))","key":"OS7upK94QD"},{"type":"outputs","id":"m9RfBKPsEWcT2KqteQCnZ","children":[],"key":"MMeS4TgXWJ"}],"key":"bB4fpvwvHC"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"b33cqVRu5r"},{"type":"heading","depth":2,"position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"Control Structures","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"Dn8EVbLhbA"}],"identifier":"control-structures","label":"Control Structures","html_id":"control-structures","implicit":true,"key":"Y4gPGDic2V"},{"type":"heading","depth":3,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Conditionals","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"VamgtQR9pT"}],"identifier":"conditionals","label":"Conditionals","html_id":"conditionals","implicit":true,"key":"lZ59fQp3RT"}],"key":"BHZ4W2epKz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"rho = 250  # Ohm·m\n\nif rho < 10:\n    print(\"Very conductive — possible clay or saline water\")\nelif rho < 100:\n    print(\"Moderately conductive — moist soil\")\nelif rho < 1000:\n    print(\"Resistive — dry soil or gravel\")\nelse:\n    print(\"Highly resistive — bedrock or dry sand\")","key":"CUEXtEN7ks"},{"type":"outputs","id":"Ia4Mc3V1Y_UI34wPeSLH6","children":[],"key":"CY6VsGQDNG"}],"key":"C95Grojjxb"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Loops","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"za6dKdOkCq"}],"identifier":"loops","label":"Loops","html_id":"loops","implicit":true,"key":"w2QulxoMwP"}],"key":"lbzFwTYDvy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"electrode_positions = [0, 1, 2, 3, 4]  # metres\n\nfor i, pos in enumerate(electrode_positions):\n    print(f\"Electrode {i+1:2d}  →  x = {pos} m\")","key":"gp5M4zJgbe"},{"type":"outputs","id":"rsgriQwesPFyrzvLTN4ol","children":[],"key":"aTCvM6NBFO"}],"key":"sxDHSlJnUN"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"lz5j8F0EQu"},{"type":"heading","depth":2,"position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"Functions","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"AEwpmhzhYi"}],"identifier":"functions","label":"Functions","html_id":"functions","implicit":true,"key":"Fa8hEEDLZz"},{"type":"paragraph","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Functions let you package reusable logic with a clear interface.","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"xE7gDBKNtK"}],"key":"doS8GCQHeb"}],"key":"qujk12qtBM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def apparent_resistivity(V, I, K):\n    \"\"\"\n    Calculate apparent resistivity.\n\n    Parameters\n    ----------\n    V : float\n        Measured voltage (V)\n    I : float\n        Applied current (A)\n    K : float\n        Geometric factor for the array (m)\n\n    Returns\n    -------\n    float\n        Apparent resistivity (Ω·m)\n    \"\"\"\n    return K * (V / I)\n\n# Wenner array with a = 1 m → K = 2πa\nimport math\na = 1.0          # electrode spacing (m)\nK_wenner = 2 * math.pi * a\n\nrho_a = apparent_resistivity(V=0.05, I=0.001, K=K_wenner)\nprint(f\"Apparent resistivity: {rho_a:.1f} Ω·m\")","key":"HAnGsV3hhY"},{"type":"outputs","id":"6RROpTt7S3cjAcDoOF3_M","children":[],"key":"G7bu3CAlt6"}],"key":"HWFVgPbujD"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"JvrUfuKaUM"},{"type":"heading","depth":2,"position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"NumPy Basics","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"n2RtzBlFHM"}],"identifier":"numpy-basics","label":"NumPy Basics","html_id":"numpy-basics","implicit":true,"key":"dp6HZdS7Vb"},{"type":"paragraph","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"link","url":"https://numpy.org","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"NumPy","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"Fl2gu8kDmW"}],"urlSource":"https://numpy.org","key":"FHGRLS51j8"},{"type":"text","value":" is the backbone of numerical computing in Python.","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"GZauJ6wcix"}],"key":"vG4ioyCGmZ"}],"key":"PP4K0Kn8xa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\n# Create an array of electrode positions\nx = np.linspace(0, 47, 48)   # 48 electrodes, 1 m spacing\nprint(f\"Electrode positions: {x[:6]} ... {x[-3:]}\")\nprint(f\"Array shape: {x.shape}\")\n\n# Vectorised arithmetic — no loops needed\nrho_values = np.random.lognormal(mean=4.5, sigma=0.5, size=48)\nprint(f\"\\nMean apparent resistivity : {rho_values.mean():.1f} Ω·m\")\nprint(f\"Std  apparent resistivity : {rho_values.std():.1f} Ω·m\")","key":"YAvDhD3Hwz"},{"type":"outputs","id":"oTj1AcDVVVTIbhm_3zW8L","children":[],"key":"yXDtYGAxWw"}],"key":"qOLYcVizXg"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"wxCVYv0CZD"},{"type":"heading","depth":2,"position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"text","value":"Matplotlib Quick Plot","position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"key":"jXqNeV5oB1"}],"identifier":"matplotlib-quick-plot","label":"Matplotlib Quick Plot","html_id":"matplotlib-quick-plot","implicit":true,"key":"nxndmvv1IZ"}],"key":"mHnEeyewUN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\n\nfig, ax = plt.subplots(figsize=(9, 3))\nax.plot(x, rho_values, 'o-', color='steelblue', markersize=4, linewidth=1)\nax.set_xlabel(\"Electrode position (m)\")\nax.set_ylabel(\"Apparent resistivity (Ω·m)\")\nax.set_title(\"Synthetic resistivity profile — Wenner array\")\nax.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.show()","key":"jSwlnL32Ck"},{"type":"outputs","id":"VH_iOdiXFcdvCKwSIdMs-","children":[],"key":"m2BJ4UKuLz"}],"key":"WPUWX8gqQ5"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":173,"column":1},"end":{"line":173,"column":1}},"key":"zOQCw53Nj2"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Summary","position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"key":"gM08o9nnyf"}],"key":"F2Yk0op28E"},{"type":"paragraph","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"children":[{"type":"text","value":"You have covered:","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"key":"NqnUh3Vjxk"}],"key":"lNa7bMh3Bu"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":177,"column":1},"end":{"line":181,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Variables, data types, and lists","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"GbMWSygBfg"}],"key":"icv4YeyKo8"}],"key":"kSNFsr7Vej"},{"type":"listItem","spread":true,"position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"if / elif / else","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"CxOul0TLlb"},{"type":"text","value":" conditionals and ","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"nGIitJRLya"},{"type":"inlineCode","value":"for","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"OaDiunJCjt"},{"type":"text","value":" loops","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"JEAMA