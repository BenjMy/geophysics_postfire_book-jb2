:"Conditionals","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"eVB5a6g5Kd"}],"identifier":"conditionals","label":"Conditionals","html_id":"conditionals","implicit":true,"key":"GyHXlh6dtI"}],"key":"GeArYOZ5Fk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"rho = 250  # Ohm·m\n\nif rho < 10:\n    print(\"Very conductive — possible clay or saline water\")\nelif rho < 100:\n    print(\"Moderately conductive — moist soil\")\nelif rho < 1000:\n    print(\"Resistive — dry soil or gravel\")\nelse:\n    print(\"Highly resistive — bedrock or dry sand\")","key":"vBf1HOuqZ9"},{"type":"outputs","id":"8T1SYT0W6jC5ye0qvNZVp","children":[],"key":"Ndb5eKb6Uq"}],"key":"kWygZ2GBKe"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Loops","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"WshvOzsr4C"}],"identifier":"loops","label":"Loops","html_id":"loops","implicit":true,"key":"I33L24LIf8"}],"key":"SFSa1pTxNn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"electrode_positions = [0, 1, 2, 3, 4]  # metres\n\nfor i, pos in enumerate(electrode_positions):\n    print(f\"Electrode {i+1:2d}  →  x = {pos} m\")","key":"LHnx0VvBL0"},{"type":"outputs","id":"RAHv18H_C-kMGJU58ZoVo","children":[],"key":"We7AsC8Kot"}],"key":"LShHRR20VA"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"mCqJ4uxnFF"},{"type":"heading","depth":2,"position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"Functions","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"jVnOm2A0Rd"}],"identifier":"functions","label":"Functions","html_id":"functions","implicit":true,"key":"V7gXZhgTyT"},{"type":"paragraph","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Functions let you package reusable logic with a clear interface.","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"U34WpPG68M"}],"key":"U8VLuIwbNi"}],"key":"CCho1fgenb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def apparent_resistivity(V, I, K):\n    \"\"\"\n    Calculate apparent resistivity.\n\n    Parameters\n    ----------\n    V : float\n        Measured voltage (V)\n    I : float\n        Applied current (A)\n    K : float\n        Geometric factor for the array (m)\n\n    Returns\n    -------\n    float\n        Apparent resistivity (Ω·m)\n    \"\"\"\n    return K * (V / I)\n\n# Wenner array with a = 1 m → K = 2πa\nimport math\na = 1.0          # electrode spacing (m)\nK_wenner = 2 * math.pi * a\n\nrho_a = apparent_resistivity(V=0.05, I=0.001, K=K_wenner)\nprint(f\"Apparent resistivity: {rho_a:.1f} Ω·m\")","key":"XtoqbTEkq7"},{"type":"outputs","id":"r1-aIK2Ak-dyjj36BPXFJ","children":[],"key":"Yn6z9dTF3r"}],"key":"tZvhyTUKUD"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"LD77AmzGJr"},{"type":"heading","depth":2,"position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"NumPy Basics","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"ZmIQdRxLzW"}],"identifier":"numpy-basics","label":"NumPy Basics","html_id":"numpy-basics","implicit":true,"key":"dVXTHDJ34O"},{"type":"paragraph","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"link","url":"https://numpy.org","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"NumPy","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"OTh7cfEzMc"}],"urlSource":"https://numpy.org","key":"jBxQ2j53NE"},{"type":"text","value":" is the backbone of numerical computing in Python.","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"z4rURxyspa"}],"key":"HDlpkj9lF3"}],"key":"H3UCRfY8xs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\n# Create an array of electrode positions\nx = np.linspace(0, 47, 48)   # 48 electrodes, 1 m spacing\nprint(f\"Electrode positions: {x[:6]} ... {x[-3:]}\")\nprint(f\"Array shape: {x.shape}\")\n\n# Vectorised arithmetic — no loops needed\nrho_values = np.random.lognormal(mean=4.5, sigma=0.5, size=48)\nprint(f\"\\nMean apparent resistivity : {rho_values.mean():.1f} Ω·m\")\nprint(f\"Std  apparent resistivity : {rho_values.std():.1f} Ω·m\")","key":"HvT3ymowcV"},{"type":"outputs","id":"pPUZGJIQvMGUP-PNDoSm3","children":[],"key":"XW0CaIUVlJ"}],"key":"YdHqYvwW6N"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"vx72Ybc7sc"},{"type":"heading","depth":2,"position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"text","value":"Matplotlib Quick Plot","position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"key":"EjmXDM3OuO"}],"identifier":"matplotlib-quick-plot","label":"Matplotlib Quick Plot","html_id":"matplotlib-quick-plot","implicit":true,"key":"K62xiXg3EK"}],"key":"IRtDAW0AcF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\n\nfig, ax = plt.subplots(figsize=(9, 3))\nax.plot(x, rho_values, 'o-', color='steelblue', markersize=4, linewidth=1)\nax.set_xlabel(\"Electrode position (m)\")\nax.set_ylabel(\"Apparent resistivity (Ω·m)\")\nax.set_title(\"Synthetic resistivity profile — Wenner array\")\nax.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.show()","key":"AJrsQbOltH"},{"type":"outputs","id":"wpLf17CHvwh4mbGxm250c","children":[],"key":"OUP3eNd0Lk"}],"key":"RIq8DxaWL0"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":173,"column":1},"end":{"line":173,"column":1}},"key":"OSV3GwGqEK"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Summary","position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"key":"Pqy2Nub5Qf"}],"key":"rnkVMUy0CA"},{"type":"paragraph","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"children":[{"type":"text","value":"You have covered:","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"key":"OP4JKMQgBA"}],"key":"Lq2qMmM3hQ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":177,"column":1},"end":{"line":181,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Variables, data types, and lists","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"WznpppUsXp"}],"key":"s7JtXsRNGo"}],"key":"wQjsmGjF4o"},{"type":"listItem","spread":true,"position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"if / elif / else","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"oDUNMzq28P"},{"type":"text","value":" conditionals and ","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"a3v1YD8Wkl"},{"type":"inlineCode","value":"for","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"H9SUqc1KXP"},{"type":"text","value":" loops","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"eGeYq