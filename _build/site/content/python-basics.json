e":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Python variables need no explicit type declaration — the interpreter infers the type from the value assigned.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"oCFVSRB8nJ"}],"key":"OpQ7P9CGeK"}],"key":"NiFD1j4xND"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Numeric types\nresistivity = 100.5   # float — Ohm·m\nnum_electrodes = 48   # int\n\n# String\nsurvey_type = \"Wenner array\"\n\n# List  \nmeasurements = [12.5, 15.3, 18.7, 21.2]  # apparent resistivity values\n\nprint(f\"Survey type       : {survey_type}\")\nprint(f\"Electrodes        : {num_electrodes}\")\nprint(f\"Resistivity (Ω·m) : {resistivity}\")\nprint(f\"Measurements      : {measurements}\")","key":"RQKd8XJDxJ"},{"type":"outputs","id":"0WXsBXbkgzOtG4qzcJXkP","children":[],"key":"SNY6RVWxb5"}],"key":"uqErlwkxHD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Check the type of a variable\nprint(type(resistivity))\nprint(type(num_electrodes))\nprint(type(survey_type))\nprint(type(measurements))","key":"X4uPJlXtqP"},{"type":"outputs","id":"puOUMjt2odOjwJRVxvd7H","children":[],"key":"N6PaLpb4f3"}],"key":"YPaW3RPBfr"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"xUEC46LOeS"},{"type":"heading","depth":2,"position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"Control Structures","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"Hq9XoTVn19"}],"identifier":"control-structures","label":"Control Structures","html_id":"control-structures","implicit":true,"key":"an0Kh3DwPc"},{"type":"heading","depth":3,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Conditionals","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"mEXHyRbtBF"}],"identifier":"conditionals","label":"Conditionals","html_id":"conditionals","implicit":true,"key":"LcEkMuR80i"}],"key":"RlhZ93VR6A"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"rho = 250  # Ohm·m\n\nif rho < 10:\n    print(\"Very conductive — possible clay or saline water\")\nelif rho < 100:\n    print(\"Moderately conductive — moist soil\")\nelif rho < 1000:\n    print(\"Resistive — dry soil or gravel\")\nelse:\n    print(\"Highly resistive — bedrock or dry sand\")","key":"Krgp7zujwe"},{"type":"outputs","id":"b8rlvdM5xKyz0L2kE6hd2","children":[],"key":"F2ECPt3hV1"}],"key":"rUVjuJJ94v"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Loops","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"wuztUPnera"}],"identifier":"loops","label":"Loops","html_id":"loops","implicit":true,"key":"MAAza5zIyH"}],"key":"OpPhIdaSLD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"electrode_positions = [0, 1, 2, 3, 4]  # metres\n\nfor i, pos in enumerate(electrode_positions):\n    print(f\"Electrode {i+1:2d}  →  x = {pos} m\")","key":"xNbTusqR1v"},{"type":"outputs","id":"qOVnyHt4nD5OQJzy9khmP","children":[],"key":"K4i4hg1Ain"}],"key":"kxB3klXqeL"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"t6N4i58w6X"},{"type":"heading","depth":2,"position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"Functions","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"b1LhManC2k"}],"identifier":"functions","label":"Functions","html_id":"functions","implicit":true,"key":"ZskcnGtNSK"},{"type":"paragraph","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Functions let you package reusable logic with a clear interface.","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"BenT7Hr6Tv"}],"key":"r51QQUherz"}],"key":"vAVGSble8d"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def apparent_resistivity(V, I, K):\n    \"\"\"\n    Calculate apparent resistivity.\n\n    Parameters\n    ----------\n    V : float\n        Measured voltage (V)\n    I : float\n        Applied current (A)\n    K : float\n        Geometric factor for the array (m)\n\n    Returns\n    -------\n    float\n        Apparent resistivity (Ω·m)\n    \"\"\"\n    return K * (V / I)\n\n# Wenner array with a = 1 m → K = 2πa\nimport math\na = 1.0          # electrode spacing (m)\nK_wenner = 2 * math.pi * a\n\nrho_a = apparent_resistivity(V=0.05, I=0.001, K=K_wenner)\nprint(f\"Apparent resistivity: {rho_a:.1f} Ω·m\")","key":"fbk2hHvt3O"},{"type":"outputs","id":"uXL7ct7iIDVBpWtm1FqRd","children":[],"key":"FXqmiJhajK"}],"key":"wAbWosOLHg"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"TCFGW7znR1"},{"type":"heading","depth":2,"position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"NumPy Basics","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"oOXHlDZn6v"}],"identifier":"numpy-basics","label":"NumPy Basics","html_id":"numpy-basics","implicit":true,"key":"d3BhhkZ4YD"},{"type":"paragraph","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"link","url":"https://numpy.org","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"NumPy","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"P39VTVWQkA"}],"urlSource":"https://numpy.org","key":"omf3nhyzxS"},{"type":"text","value":" is the backbone of numerical computing in Python.","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"m2TpWLfPeW"}],"key":"PWeWKZrS3A"}],"key":"TcNpfgLAMU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\n# Create an array of electrode positions\nx = np.linspace(0, 47, 48)   # 48 electrodes, 1 m spacing\nprint(f\"Electrode positions: {x[:6]} ... {x[-3:]}\")\nprint(f\"Array shape: {x.shape}\")\n\n# Vectorised arithmetic — no loops needed\nrho_values = np.random.lognormal(mean=4.5, sigma=0.5, size=48)\nprint(f\"\\nMean apparent resistivity : {rho_values.mean():.1f} Ω·m\")\nprint(f\"Std  apparent resistivity : {rho_values.std():.1f} Ω·m\")","key":"qZMLwFF2bu"},{"type":"outputs","id":"Kr8p-1gfaMgHWxM_8UOAM","children":[],"key":"QAOOQleOL8"}],"key":"YLFfNvmqJX"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"lPuylcWDKY"},{"type":"heading","depth":2,"position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"text","value":"Matplotlib Quick Plot","position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"key":"mED0JvkNHb"}],"identifier":"matplotlib-quick-plot","label":"Matplotlib Quick Plot","html_id":"matplotlib-quick-plot","implicit":true,"key":"T9C9POwAcY"}],"key":"K2zeDba5gO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\n\nfig, ax = plt.subplots(figsize=(9, 3))\nax.plot(x, rho_values, 'o-', color='steelblue', markersize=4, linewidth=1)\nax.set_xlabel(\"Electrode position (m)\")\nax.set_ylabel(\"Apparent resistivity (Ω·m)\")\nax.set_title(\"Synthetic resistivity profile — Wenner array\")\nax.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.show()","key":"DLqSwe1uNy"},{"type":"outputs","id":"e9ApIKImXwiQTnQlYGHUt","children":[],"key":"dmI2Eh8TuL"}],"key":"TKLWv8ZQAi"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":173,"column":1},"end":{"line":173,"column":1}},"key":"z23zDz1jRf"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Summary","position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"key":"uaWL3VaPgV"}],"key":"xC622ehYe4"},{"type":"paragraph","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"children":[{"type":"text","value":"You have covered:","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"key":"xplaQQE7av"}],"key":"pOCp3IaZrX"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":177,"column":1},"end":{"line":181,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Variables, data types, and lists","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"OvAGY7ng2x"}],"key":"IeIRsDk5Cl"}],"key":"ZDMVOb4rwj"},{"type":"listItem","spread":true,"position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"if / elif / else","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"eRT21vWYZm"},{"type":"text","value":" conditionals and ","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"rYkliVvJ4u"},{"type":"inlineCode","value":"for","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"xbqMGo9ZOD"},{"type":"text","value":" loops","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"pZjs0