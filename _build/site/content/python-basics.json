ic resistivity profile — Wenner array\")\nax.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.show()","key":"iQiTnubTEV"},{"type":"outputs","id":"Ve1rPCFarAJZx-LYarpVP","children":[],"key":"RtK2wRIQO0"}],"key":"r71JkXuqiz"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":173,"column":1},"end":{"line":173,"column":1}},"key":"fMOaurYnQe"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Summary","position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"key":"Pv1IVhoC1A"}],"key":"xaWmokY8nm"},{"type":"paragraph","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"children":[{"type":"text","value":"You have covered:","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"key":"U5j2eiovIE"}],"key":"twiLuHyQGl"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":177,"column":1},"end":{"line":181,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Variables, data types, and lists","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"NfUvv4W180"}],"key":"oynBrrSqVU"}],"key":"UWNyWjXI3O"},{"type":"listItem","spread":true,"position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"if / elif / else","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"hVZePCbz8o"},{"type":"text","value":" conditionals and ","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"U2xbGD1Dsf"},{"type":"inlineCode","value":"for","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"WNdHF1MOsq"},{"type":"text","value":" loops","position":{"start":{"line":178,"column":1},"end":{"line