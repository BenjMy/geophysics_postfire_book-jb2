{"version":3,"kind":"Notebook","sha256":"ba1d46f9a1c4d9259067bfbdf96b5eba49e9fe7821cd7a99b895eee361470cf1","slug":"er-concept","location":"/notebooks/02_resistivity/012_ER_concept.md","dependencies":[],"frontmatter":{"title":"Electrical Resistivity","kernelspec":{"name":"python3","display_name":"Python 3 (Geophysics)","language":"python"},"authors":[{"nameParsed":{"literal":"Benjamin Mary","given":"Benjamin","family":"Mary"},"name":"Benjamin Mary","orcid":"0000-0003-0815-842X","corresponding":true,"email":"benjamin.mary@ica.csic.es","affiliations":["Instituto de Ciencias Agrarias","CSIC"],"id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"Héctor Nieto","given":"Héctor","family":"Nieto"},"name":"Héctor Nieto","orcid":"0000-0003-4250-6424","email":"hector.nieto@ica.csic.es","affiliations":["Instituto de Ciencias Agrarias","CSIC"],"id":"contributors-myst-generated-uid-1"},{"nameParsed":{"literal":"María Burguet Marimón","given":"María Burguet","family":"Marimón"},"name":"María Burguet Marimón","orcid":"0000-0002-9748-8078","affiliations":["Instituto de Ciencias Agrarias","CSIC"],"id":"contributors-myst-generated-uid-2"}],"date":"2025-01-19","doi":"10.5281/zenodo.0000000","license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true},"code":{"id":"MIT","url":"https://opensource.org/licenses/MIT","name":"MIT License","free":true,"osi":true}},"github":"https://github.com/BenjMy/geophysics_postfire_book-jb2","numbering":{"heading_1":{"enabled":false},"heading_2":{"enabled":false},"heading_3":{"enabled":false},"heading_4":{"enabled":false},"heading_5":{"enabled":false},"heading_6":{"enabled":false},"title":{"offset":1}},"keywords":["geophysics","electrical resistivity tomography","electromagnetic induction","python","resipy","emagpy","open education"],"copyright":"2025","affiliations":[{"id":"Instituto de Ciencias Agrarias","name":"Instituto de Cienci